mobile/android/
mobile/.widget_preview/
mobile/.metadata

# Local backups and editor recovery copies (kept on disk)
backups/
*.bak

# Secrets and signing material
.env
.env.*
!.env.example
key.properties
**/key.properties
**/*.jks
**/*.keystore
**/*.p12
**/*.mobileprovision
**/*.provisionprofile
**/GoogleService-Info.plist
**/google-services.json
