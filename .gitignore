# macOS metadata
.DS_Store
.AppleDouble
.LSOverride

# IDE and machine-local state
.idea/
.vscode/
*.iml
**/local.properties

# Swift Package Manager and built app products
.build/
desktop/build/
desktop/.swiftpm/

# Flutter generated files
mobile/.dart_tool/
mobile/build/
